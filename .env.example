# Copy to .env and fill in. Never commit .env.
# API credentials of YOUR account: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (human-readable) | json (for log collectors); the Docker image defaults to json
# LOG_FORMAT=console

# Paths are set by the Docker image; override only when running outside Docker.
# DATA_DIR=data
# CONFIG_PATH=config.yaml
